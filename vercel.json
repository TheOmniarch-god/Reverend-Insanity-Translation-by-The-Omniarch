{
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/search", "destination": "/search.html" },
    { "source": "/notes", "destination": "/notes.html" },
    { "source": "/world", "destination": "/world.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/support", "destination": "/support.html" },
    { "source": "/preface", "destination": "/preface.html" },
    { "source": "/chapter-1", "destination": "/chapter-1.html" }
  ],
  "redirects": [
    { "source": "/wiki/world", "destination": "/world", "permanent": true },
    { "source": "/Wiki", "destination": "/world", "permanent": true },
    { "source": "/World", "destination": "/world", "permanent": true },
    { "source": "/Notes", "destination": "/notes", "permanent": true },
    { "source": "/Search", "destination": "/search", "permanent": true },
    { "source": "/About", "destination": "/about", "permanent": true },
    { "source": "/Support", "destination": "/support", "permanent": true },
    { "source": "/Preface", "destination": "/preface", "permanent": true }
  ],
  "github": { "silent": true }
}
